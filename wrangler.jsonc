{
  "name": "dogancanyucel-website",
  "main": "index.js",
  "compatibility_date": "2026-07-07",
  "assets": {
    "directory": "./public",
    // Without this, Cloudflare answers every request that matches a file in public/ at the edge and NEVER runs the
    // Worker. Measured on the live site 2026-11-07: `/` and `/style.css` came back with no Content-Security-Policy at
    // all, while `/no-such-page` (no file, so the Worker ran) carried all four headers — the hardening shipped the day
    // before reached nothing a reader actually opens. The same short-circuit skipped `recordVisit`, so the page tally
    // behind /stats was counting no page views either. Everything now goes through index.js, which serves the file via
    // env.ASSETS and adds the headers.
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "dogancanyucel.com/*",
      "zone_name": "dogancanyucel.com"
    },
    {
      "pattern": "app.dogancanyucel.com/*",
      "zone_name": "dogancanyucel.com"
    }
  ],
  // The exercise clips, private — see clips.js. The bucket is created by the owner.
  "r2_buckets": [
    {
      "binding": "CLIPS",
      "bucket_name": "turquoise-exercise-clips"
    }
  ],
  // Per signed-in user, per minute; Cloudflare allows only 10 or 60 second windows.
  // 20 clips covers opening a whole training day at once; 2,500 in bulk would take two hours.
  "ratelimits": [
    {
      "name": "CLIP_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "CATALOGUE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exercises_db",
      "database_id": "61c91ab8-fa3d-465d-8e95-768f5e10a48d"
    }
  ]
}