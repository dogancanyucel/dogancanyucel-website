{
  "name": "dogancanyucel-website",
  "main": "index.js",
  "compatibility_date": "2026-07-07",
  "assets": {
    "directory": "./public",
    // `env.ASSETS` does not exist without this line, and index.js serves every static file through it. Nobody noticed
    // for as long as Cloudflare answered those files at its own edge and the Worker only ever saw the misses — where
    // `if (env.ASSETS)` quietly fell through to "Not Found". Measured 2026-11-07: /no-such-page came back
    // `text/plain;charset=UTF-8`, which is the Worker's own fallback, not the asset layer's 404.
    "binding": "ASSETS",
    // Without this, Cloudflare answers every request matching a file in public/ at its own edge and never runs the
    // Worker. Measured live 2026-11-07: `/` and `/style.css` carried no Content-Security-Policy while `/no-such-page`
    // carried all four, because only the miss reached index.js — and `recordVisit` was skipped the same way, so the
    // page tally behind /stats counted nothing. Turning it on once without the binding above took the home page down
    // for two minutes; the binding is proved live (the 404 is the asset layer's, not the Worker's) before this line.
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "dogancanyucel.com/*",
      "zone_name": "dogancanyucel.com"
    },
    {
      "pattern": "app.dogancanyucel.com/*",
      "zone_name": "dogancanyucel.com"
    }
  ],
  // The exercise clips, private — see clips.js. The bucket is created by the owner.
  "r2_buckets": [
    {
      "binding": "CLIPS",
      "bucket_name": "turquoise-exercise-clips"
    }
  ],
  // Per signed-in user, per minute; Cloudflare allows only 10 or 60 second windows.
  // 20 clips covers opening a whole training day at once; 2,500 in bulk would take two hours.
  "ratelimits": [
    {
      "name": "CLIP_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "CATALOGUE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exercises_db",
      "database_id": "61c91ab8-fa3d-465d-8e95-768f5e10a48d"
    }
  ]
}